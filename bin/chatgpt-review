#!/usr/bin/env bash
# Ensure playwright can be resolved from bridge when running from repo
BRIDGE_NM="$HOME/.gemini/chatgpt-bridge/node_modules"
if [ -d "$BRIDGE_NM" ]; then
  export NODE_PATH="$BRIDGE_NM${NODE_PATH:+:$NODE_PATH}"
else
  # fallback to legacy opencode bridge (when symlinked)
  LEGACY="$HOME/.config/opencode/chatgpt-bridge/node_modules"
  if [ -d "$LEGACY" ]; then
    export NODE_PATH="$LEGACY${NODE_PATH:+:$NODE_PATH}"
  fi
fi
exec node "$(dirname "$(realpath "$0")")/chatgpt-review.mjs" "$@"
